    function Window:NewTab(name)

        if Pages[name] then
            warn("ZTE HUB: Tab already exists: " .. name)
            return nil
        end

        local page = Create("ScrollingFrame", {
            Name = name,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.Purple,
