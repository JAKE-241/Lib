            local humanoid = GetHumanoid()

            if humanoid then
                humanoid.Health = 0
            end
        end
    )

    --====================================================
    -- MINIMIZE / REOPEN
    --====================================================

    local OpenBubble = Create("TextButton", {
        Name = "ZTE_OpenBubble",
        Text = "♛ ZTE",
        TextSize = 15,
        Font = Enum.Font.GothamBlack,
        TextColor3 = Theme.White,
        BackgroundColor3 = Theme.Blue,
        Size = UDim2.fromOffset(105, 42),
        Position = UDim2.new(0, 15, 0.5, -21),
        Visible = false
    }, ScreenGui)

    Corner(OpenBubble, 12)
    Outline(OpenBubble, Theme.Purple, 2)

    Minimize.MouseButton1Click:Connect(function()
        Main.Visible = false
        OpenBubble.Visible = true
    end)

    OpenBubble.MouseButton1Click:Connect(function()
        Main.Visible = true
        OpenBubble.Visible = false
    end)

    Close.MouseButton1Click:Connect(function()
        StopFly()
        ScreenGui:Destroy()
    end)

    --====================================================
    -- DRAGGABLE WINDOW
    --====================================================

    local dragging = false
    local dragStart
    local startPosition

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    --====================================================
    -- RESPAWN HANDLING
    --====================================================

    Player.CharacterAdded:Connect(function(character)
        StopFly()

        local humanoid = character:WaitForChild("Humanoid")

        task.wait(0.2)

        humanoid.WalkSpeed = SpeedEnabled and SpeedValue or DefaultSpeed

        NoclipEnabled = false
        table.clear(OriginalCollision)
    end)

    --====================================================
    -- WINDOW METHODS
    --====================================================

    function Window:Destroy()
        StopFly()
        ScreenGui:Destroy()
    end

    function Window:SelectTab(name)
        if Pages[name] then
            SelectTab(name)
        end
    end

    print("ZTE HUB | Cyber Library loaded!")

    return Window
end

