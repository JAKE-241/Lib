            local switch = Create("TextButton", {
                Text = "",
                BackgroundColor3 = enabled and Theme.Blue or Theme.Background,
                Size = UDim2.fromOffset(45, 24),
                Position = UDim2.new(1, -55, 0.5, -12)
            }, row)

            Corner(switch, 20)

            local knob = Create("Frame", {
                BackgroundColor3 = Theme.White,
                Size = UDim2.fromOffset(18, 18),
                Position = enabled and UDim2.new(1, -21, 0, 3)
                    or UDim2.fromOffset(3, 3)
            }, switch)

            Corner(knob, 20)

            local function Set(value)
                enabled = value

                switch.BackgroundColor3 =
                    enabled and Theme.Blue or Theme.Background

                knob.Position = enabled and
                    UDim2.new(1, -21, 0, 3) or
                    UDim2.fromOffset(3, 3)

                if callback then
                    task.spawn(callback, enabled)
                end
            end

            switch.MouseButton1Click:Connect(function()
                Set(not enabled)
            end)

            return {
                Set = Set,
                Get = function()
                    return enabled
                end
            }
        end

        -- SLIDER
        function Section:NewSlider(text, min, max, default, callback)

            local value = default or min

            local row = Create("Frame", {
                BackgroundColor3 = Theme.Panel2,
                Size = UDim2.new(1, 0, 0, 64)
            }, holder)

            Corner(row, 9)

            local label = MakeLabel(
                row,
                text .. ": " .. tostring(value),
                13,
                Theme.White
            )

            label.Position = UDim2.fromOffset(11, 3)
            label.Size = UDim2.new(1, -22, 0, 24)

            local bar = Create("TextButton", {
                Text = "",
                BackgroundColor3 = Theme.Background,
                Position = UDim2.fromOffset(11, 39),
                Size = UDim2.new(1, -22, 0, 9)
            }, row)

            Corner(bar, 10)

            local fill = Create("Frame", {
                BackgroundColor3 = Theme.Blue,
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            }, bar)

            Corner(fill, 10)
            MakeGradient(fill)

            local dragging = false

            local function SetValueFromX(x)
                local width = math.max(bar.AbsoluteSize.X, 1)

                local ratio = math.clamp(
                    (x - bar.AbsolutePosition.X) / width,
                    0,
                    1
                )

                value = math.floor(min + ratio * (max - min))

                fill.Size = UDim2.new(ratio, 0, 1, 0)
                label.Text = text .. ": " .. tostring(value)

                if callback then
                    task.spawn(callback, value)
                end
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = true
                    SetValueFromX(input.Position.X)
                end
            end)

            UIS.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    SetValueFromX(input.Position.X)
                end
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local Slider = {}

            function Slider:Set(newValue)
                value = math.clamp(newValue, min, max)
                local ratio = (value - min) / (max - min)

                fill.Size = UDim2.new(ratio, 0, 1, 0)
                label.Text = text .. ": " .. tostring(value)

                if callback then
                    task.spawn(callback, value)
                end
            end

            function Slider:Get()
                return value
            end

            return Slider
        end

        return Section
    end

