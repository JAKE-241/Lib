--========================================================
-- HELPERS
--========================================================

local function Create(class, props, parent)
    local object = Instance.new(class)

    for property, value in pairs(props or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Corner(parent, radius)
    Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, parent)
end

local function Outline(parent, color, thickness)
    return Create("UIStroke", {
        Color = color or Theme.Blue,
        Thickness = thickness or 1,
        Transparency = 0.15
    }, parent)
end

local function MakeGradient(parent)
    Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Blue),
            ColorSequenceKeypoint.new(1, Theme.Purple)
        })
    }, parent)
end

local function MakeLabel(parent, text, size, color, font)
    return Create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextSize = size or 14,
        TextColor3 = color or Theme.White,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 0, 25)
    }, parent)
end

local function GetCharacter()
    return Player.Character
end

local function GetHumanoid()
    local character = GetCharacter()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot()
    local character = GetCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

