function Section:NewButton(Name, Description, Callback)

    Callback = Callback or function() end

    local Button = Instance.new("TextButton")
    Button.Name = Name
    Button.Size = UDim2.new(1, 0, 0, 42)
    Button.BackgroundColor3 = Theme.Element
    Button.BorderSizePixel = 0
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = self.Holder

    Instance.new("UICorner", Button).CornerRadius =
        UDim.new(0, 7)

    local ButtonTitle = Instance.new("TextLabel")
    ButtonTitle.Size = UDim2.new(1, -45, 1, 0)
    ButtonTitle.Position = UDim2.new(0, 12, 0, 0)
    ButtonTitle.BackgroundTransparency = 1
    ButtonTitle.Text = Name
    ButtonTitle.TextColor3 = Theme.Text
    ButtonTitle.TextSize = 13
    ButtonTitle.Font = Enum.Font.GothamSemibold
    ButtonTitle.TextXAlignment = Enum.TextXAlignment.Left
    ButtonTitle.Parent = Button

    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 30, 1, 0)
    Arrow.Position = UDim2.new(1, -35, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "›"
    Arrow.TextColor3 = Theme.Blue
    Arrow.TextSize = 24
    Arrow.Font = Enum.Font.GothamBold
    Arrow.Parent = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.2),
            {BackgroundColor3 = Theme.Stroke}
        ):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.2),
            {BackgroundColor3 = Theme.Element}
        ):Play()
    end)

    Button.MouseButton1Click:Connect(function()
        pcall(Callback)
    end)

    return Button
end

