        -- TOGGLE
        function Section:NewToggle(text, default, callback)

            local enabled = default or false

            local row = Create("Frame", {
                BackgroundColor3 = Theme.Panel2,
                Size = UDim2.new(1, 0, 0, 43)
            }, holder)

            Corner(row, 9)

            local label = MakeLabel(row, text, 13, Theme.White)
