function Section:NewDropdown(Name, Description, Options, Callback)

    Callback = Callback or function() end
    Options = Options or {}

    local Selected = nil
    local Open = false

    local Container = Instance.new("Frame")
    Container.Name = Name
    Container.Size = UDim2.new(1, 0, 0, 42)
    Container.BackgroundColor3 = Theme.Element
    Container.BorderSizePixel = 0
    Container.ClipsDescendants = true
    Container.Parent = self.Holder

    Instance.new("UICorner", Container).CornerRadius =
        UDim.new(0, 7)

    local Header = Instance.new("TextButton")
    Header.Size = UDim2.new(1, 0, 0, 42)
    Header.BackgroundTransparency = 1
    Header.Text = ""
    Header.Parent = Container

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0.65, 0, 1, 0)
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = Name
    Title.TextColor3 = Theme.Text
    Title.TextSize = 13
    Title.Font = Enum.Font.GothamSemibold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Header

    local SelectedLabel = Instance.new("TextLabel")
    SelectedLabel.Size = UDim2.new(0.3, -10, 1, 0)
    SelectedLabel.Position = UDim2.new(0.7, 0, 0, 0)
    SelectedLabel.BackgroundTransparency = 1
    SelectedLabel.Text = "Select  ▼"
    SelectedLabel.TextColor3 = Theme.Blue
    SelectedLabel.TextSize = 11
    SelectedLabel.Font = Enum.Font.Gotham
    SelectedLabel.Parent = Header

    local OptionHolder = Instance.new("Frame")
    OptionHolder.Position = UDim2.new(0, 8, 0, 45)
    OptionHolder.Size = UDim2.new(1, -16, 0, 0)
    OptionHolder.BackgroundTransparency = 1
    OptionHolder.Parent = Container

    local OptionLayout = Instance.new("UIListLayout")
    OptionLayout.Padding = UDim.new(0, 5)
    OptionLayout.Parent = OptionHolder

    local function RefreshOptions()

        for _, Child in ipairs(OptionHolder:GetChildren()) do
            if Child:IsA("TextButton") then
                Child:Destroy()
            end
        end

        for _, Option in ipairs(Options) do

            local OptionButton = Instance.new("TextButton")
            OptionButton.Size = UDim2.new(1, 0, 0, 30)
            OptionButton.BackgroundColor3 = Theme.Panel
            OptionButton.Text = tostring(Option)
            OptionButton.TextColor3 = Theme.Text
            OptionButton.TextSize = 12
            OptionButton.Font = Enum.Font.Gotham
            OptionButton.Parent = OptionHolder

            Instance.new("UICorner", OptionButton).CornerRadius =
                UDim.new(0, 5)

            OptionButton.MouseButton1Click:Connect(function()

                Selected = Option
                SelectedLabel.Text = tostring(Option)

                Open = false
                Container.Size = UDim2.new(1, 0, 0, 42)

                pcall(Callback, Option)
            end)
        end

        OptionHolder.Size = UDim2.new(
            1, -16, 0, OptionLayout.AbsoluteContentSize.Y
        )
    end

    Header.MouseButton1Click:Connect(function()

        Open = not Open

        if Open then
            Container.Size = UDim2.new(
                1, 0, 0, 50 + OptionLayout.AbsoluteContentSize.Y
            )
        else
            Container.Size = UDim2.new(1, 0, 0, 42)
        end
    end)

    RefreshOptions()

    Container.Refresh = function(NewOptions)
        Options = NewOptions or {}
        RefreshOptions()
    end

    Container.GetValue = function()
        return Selected
    end

    return Container
end

