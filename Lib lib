        -- TOGGLE
        function Section:NewToggle(text, default, callback)

            local enabled = default == true

            local row = Create("Frame", {
                BackgroundColor3 = Theme.Panel2,
                Size = UDim2.new(1, 0, 0, 40)
            }, holder)

            Corner(row, 9)

            local label = MakeLabel(row, text, 12, Theme.White)
            label.Position = UDim2.fromOffset(10, 0)
            label.Size = UDim2.new(1, -70, 1, 0)

            local switch = Create("TextButton", {
                Text = "",
                BackgroundColor3 = enabled and Theme.Blue or Theme.Background,
                Size = UDim2.fromOffset(42, 22),
                Position = UDim2.new(1, -52, 0.5, -11)
            }, row)

            Corner(switch, 20)

            local knob = Create("Frame", {
                BackgroundColor3 = Theme.White,
                Size = UDim2.fromOffset(16, 16),
                Position = enabled and UDim2.new(1, -19, 0, 3)
                    or UDim2.fromOffset(3, 3)
            }, switch)

            Corner(knob, 20)

            local function Set(value)
                enabled = value == true

                switch.BackgroundColor3 =
                    enabled and Theme.Blue or Theme.Background

                knob.Position = enabled
                    and UDim2.new(1, -19, 0, 3)
                    or UDim2.fromOffset(3, 3)

                if callback then
                    task.spawn(callback, enabled)
                end
            end

            switch.Activated:Connect(function()
                Set(not enabled)
            end)

            return {
                Set = Set,
                Get = function()
                    return enabled
                end
            }
        end

        -- SLIDER
        function Section:NewSlider(text, min, max, default, callback)

            local value = math.clamp(default or min, min, max)

            local row = Create("Frame", {
                BackgroundColor3 = Theme.Panel2,
                Size = UDim2.new(1, 0, 0, 58)
            }, holder)

            Corner(row, 9)

            local label = MakeLabel(
                row, text .. ": " .. tostring(value), 12, Theme.White
            )

            label.Position = UDim2.fromOffset(10, 2)
            label.Size = UDim2.new(1, -20, 0, 22)

            local bar = Create("TextButton", {
                Text = "",
                BackgroundColor3 = Theme.Background,
                Position = UDim2.fromOffset(10, 35),
                Size = UDim2.new(1, -20, 0, 8),
                AutoButtonColor = false
            }, row)

            Corner(bar, 10)

            local fill = Create("Frame", {
                BackgroundColor3 = Theme.Blue,
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            }, bar)

            Corner(fill, 10)
            MakeGradient(fill)

            local dragging = false

            local function SetValueFromX(x)
                local width = math.max(bar.AbsoluteSize.X, 1)

                local ratio = math.clamp(
                    (x - bar.AbsolutePosition.X) / width,
                    0, 1
                )

                value = math.floor(min + ratio * (max - min))

                fill.Size = UDim2.new(ratio, 0, 1, 0)
                label.Text = text .. ": " .. tostring(value)

                if callback then
                    task.spawn(callback, value)
                end
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = true
                    SetValueFromX(input.Position.X)
                end
            end)

            UIS.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    SetValueFromX(input.Position.X)
                end
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local Slider = {}

            function Slider:Set(newValue)
                value = math.clamp(newValue, min, max)

                local ratio = (value - min) / (max - min)
                fill.Size = UDim2.new(ratio, 0, 1, 0)
                label.Text = text .. ": " .. tostring(value)

                if callback then
                    task.spawn(callback, value)
                end
            end

            function Slider:Get()
                return value
            end

            return Slider
        end

        return Section
    end

