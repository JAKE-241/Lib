    local function WatchCamera()
        if cameraConnection then
            cameraConnection:Disconnect()
        end

        local camera = workspace.CurrentCamera
        if camera then
            cameraConnection =
                camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
        end

        UpdateScale()
    end

