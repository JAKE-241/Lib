--==================================================
-- KEYBIND
--==================================================

function Section:NewKeybind(Name, Description, DefaultKey, Callback)

    Callback = Callback or function() end

    local CurrentKey = DefaultKey or Enum.KeyCode.RightShift
    local Listening = false

    local Container = Instance.new("TextButton")
    Container.Name = Name
    Container.Size = UDim2.new(1, 0, 0, 42)
    Container.BackgroundColor3 = Theme.Element
    Container.Text = ""
    Container.AutoButtonColor = false
    Container.Parent = self.Holder

    Instance.new("UICorner", Container).CornerRadius =
        UDim.new(0, 7)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0.65, 0, 1, 0)
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = Name
    Title.TextColor3 = Theme.Text
    Title.TextSize = 13
    Title.Font = Enum.Font.GothamSemibold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Container

    local KeyLabel = Instance.new("TextLabel")
    KeyLabel.Size = UDim2.new(0, 95, 0, 27)
    KeyLabel.Position = UDim2.new(1, -105, 0.5, -13)
    KeyLabel.BackgroundColor3 = Theme.Panel
    KeyLabel.Text = CurrentKey.Name
    KeyLabel.TextColor3 = Theme.Blue
    KeyLabel.TextSize = 11
    KeyLabel.Font = Enum.Font.GothamBold
    KeyLabel.Parent = Container

    Instance.new("UICorner", KeyLabel).CornerRadius =
        UDim.new(0, 5)

    Container.MouseButton1Click:Connect(function()
        Listening = true
        KeyLabel.Text = "Press key..."
    end)

    local Connection

    Connection = UIS.InputBegan:Connect(function(Input, Processed)

        if Listening then
            if Input.UserInputType == Enum.UserInputType.Keyboard then
                CurrentKey = Input.KeyCode
                KeyLabel.Text = CurrentKey.Name
                Listening = false
            end
            return
        end

        if not Processed
        and Input.UserInputType == Enum.UserInputType.Keyboard
        and Input.KeyCode == CurrentKey then

            pcall(Callback, CurrentKey)
        end
    end)

    Container.Destroying:Connect(function()
        if Connection then
            Connection:Disconnect()
        end
    end)

    Container.GetKey = function()
        return CurrentKey
    end

    return Container
end

