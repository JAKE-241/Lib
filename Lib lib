    --====================================================

    function Window:Destroy()
        StopFly()

        if cameraConnection then
            cameraConnection:Disconnect()
        end

        ScreenGui:Destroy()
    end

    function Window:SelectTab(name)
        if Pages[name] then
            SelectTab(name)
        end
    end

    print("ZTE HUB | Cyber Library v2.0 loaded!")

    return Window
end

return Library
