    --====================================================
    -- FLY SYSTEM
    -- Mobile joystick + camera pitch
    --====================================================

    local function StopFly()
        FlyEnabled = false

        if FlyConnection then
            FlyConnection:Disconnect()
            FlyConnection = nil
        end

        if FlyVelocity then
            FlyVelocity:Destroy()
            FlyVelocity = nil
        end

        if FlyGyro then
            FlyGyro:Destroy()
            FlyGyro = nil
        end

        if FlyAttachment then
            FlyAttachment:Destroy()
            FlyAttachment = nil
        end

        local humanoid = GetHumanoid()

        if humanoid then
            humanoid.AutoRotate = OldAutoRotate ~= nil and OldAutoRotate or true
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

        OldAutoRotate = nil
    end

    local function StartFly()
        StopFly()

        local character = GetCharacter()
        local humanoid = GetHumanoid()
        local root = GetRoot()

        if not character or not humanoid or not root then
            return
        end

        FlyEnabled = true
        OldAutoRotate = humanoid.AutoRotate
        humanoid.AutoRotate = false
        humanoid.PlatformStand = false

        FlyAttachment = Instance.new("Attachment")
        FlyAttachment.Name = "ZTE_FlyAttachment"
        FlyAttachment.Parent = root

        FlyVelocity = Instance.new("LinearVelocity")
        FlyVelocity.Name = "ZTE_FlyVelocity"
        FlyVelocity.Attachment0 = FlyAttachment
        FlyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        FlyVelocity.VelocityConstraintMode =
            Enum.VelocityConstraintMode.Vector
        FlyVelocity.MaxForce = 1000000
        FlyVelocity.VectorVelocity = Vector3.zero
        FlyVelocity.Parent = root

        FlyGyro = Instance.new("AlignOrientation")
        FlyGyro.Name = "ZTE_FlyOrientation"
        FlyGyro.Attachment0 = FlyAttachment
        FlyGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
        FlyGyro.MaxTorque = 1000000
        FlyGyro.Responsiveness = 15
        FlyGyro.Parent = root

        FlyConnection = RunService.RenderStepped:Connect(function()
            if not FlyEnabled then return end
            if not root.Parent or not humanoid.Parent then
                StopFly()
                return
            end

            local camera = workspace.CurrentCamera
            if not camera then return end

            -- Roblox mobile joystick gives world-space MoveDirection.
            local move = humanoid.MoveDirection

            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector

            local flatForward = Vector3.new(look.X, 0, look.Z)
            local flatRight = Vector3.new(right.X, 0, right.Z)

            if flatForward.Magnitude > 0.001 then
                flatForward = flatForward.Unit
            else
                flatForward = Vector3.new(0, 0, -1)
            end

            if flatRight.Magnitude > 0.001 then
                flatRight = flatRight.Unit
            else
                flatRight = Vector3.new(1, 0, 0)
            end

            local forwardInput = math.clamp(move:Dot(flatForward), -1, 1)
            local sideInput = math.clamp(move:Dot(flatRight), -1, 1)

            -- Camera pitch controls climbing and descending.
            local pitch = math.clamp(look.Y, -0.95, 0.95)
            local horizontalForward = math.sqrt(1 - pitch * pitch)

            local direction =
                (flatForward * forwardInput * horizontalForward)
                + (flatRight * sideInput)
                + Vector3.new(0, forwardInput * pitch, 0)

            if direction.Magnitude > 1 then
                direction = direction.Unit
            end

            FlyVelocity.VectorVelocity = direction * 55

            -- Face camera yaw only to avoid camera rotation feedback.
            local faceDirection = Vector3.new(look.X, 0, look.Z)

            if faceDirection.Magnitude > 0.001 then
                FlyGyro.CFrame = CFrame.lookAt(
                    root.Position,
                    root.Position + faceDirection.Unit
                )
            end
        end)
    end

