local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local Library = {}

local Theme = {
    Background = Color3.fromRGB(10, 12, 22),
    Sidebar = Color3.fromRGB(14, 18, 32),
    Panel = Color3.fromRGB(19, 24, 42),
    Element = Color3.fromRGB(25, 32, 55),
    Blue = Color3.fromRGB(0, 170, 255),
    Purple = Color3.fromRGB(145, 70, 255),
    Text = Color3.fromRGB(240, 245, 255),
    SubText = Color3.fromRGB(135, 150, 180),
    Stroke = Color3.fromRGB(45, 65, 105)
}

local function Corner(Object, Radius)
    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0, Radius or 7)
    C.Parent = Object
    return C
end

local function Make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

--==================================================
-- CREATE LIBRARY
--==================================================

function Library.CreateLib(Title, ThemeName)

    local Window = {
        Tabs = {},
        CurrentTab = nil
    }

    local Old = PlayerGui:FindFirstChild("ZTE_CYBER_UI")
    if Old then Old:Destroy() end

    local Gui = Make("ScreenGui", {
        Name = "ZTE_CYBER_UI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, PlayerGui)

    local Main = Make("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(650, 420),
        Position = UDim2.new(0.5, -325, 0.5, -210),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, Gui)

    Corner(Main, 12)

    Make("UIStroke", {
        Color = Theme.Blue,
        Thickness = 1.5
    }, Main)

    local Top = Make("Frame", {
        Size = UDim2.new(1, 0, 0, 55),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0
    }, Main)

    Corner(Top, 12)

    Make("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(18, 0),
        BackgroundTransparency = 1,
        Text = "♛  " .. tostring(Title or "ZTE HUB"),
        TextColor3 = Theme.Text,
        TextSize = 19,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Top)

    local Minimize = Make("TextButton", {
        Size = UDim2.fromOffset(35, 35),
        Position = UDim2.new(1, -47, 0, 10),
        BackgroundColor3 = Theme.Element,
        Text = "—",
        TextColor3 = Theme.Blue,
        TextSize = 20,
        Font = Enum.Font.GothamBold
    }, Top)

    Corner(Minimize, 8)

    local Sidebar = Make("Frame", {
        Position = UDim2.fromOffset(0, 55),
        Size = UDim2.new(0, 155, 1, -55),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, Main)

    local SideLayout = Make("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Sidebar)

    Make("UIPadding", {
        PaddingTop = UDim.new(0, 15),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10)
    }, Sidebar)

    local Content = Make("Frame", {
        Position = UDim2.new(0, 155, 0, 55),
        Size = UDim2.new(1, -155, 1, -55),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0
    }, Main)

    local Bubble = Make("TextButton", {
        Size = UDim2.fromOffset(55, 55),
        Position = UDim2.new(0, 20, 0.5, 0),
        BackgroundColor3 = Theme.Panel,
        Text = "Z",
        TextColor3 = Theme.Blue,
        TextSize = 25,
        Font = Enum.Font.GothamBold,
        Visible = false
    }, Gui)

    Corner(Bubble, 28)

    Make("UIStroke", {
        Color = Theme.Purple,
        Thickness = 2
    }, Bubble)

    Minimize.MouseButton1Click:Connect(function()
        Main.Visible = false
        Bubble.Visible = true
    end)

    Bubble.MouseButton1Click:Connect(function()
        Main.Visible = true
        Bubble.Visible = false
    end)

    -- Dragging
    local Dragging = false
    local DragStart
    local StartPosition

    Top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = input.Position
            StartPosition = Main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if Dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - DragStart
            Main.Position = UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset + delta.X,
                StartPosition.Y.Scale,
                StartPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    Window.ScreenGui = Gui
    Window.Main = Main
    Window.Theme = Theme
    Window.Sidebar = Sidebar
    Window.Content = Content

    --==================================================
    -- TAB
    --==================================================

    function Window:NewTab(TabName)

        local Tab = {
            Name = TabName,
            Sections = {}
        }

        local TabButton = Make("TextButton", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundTransparency = 1,
            Text = "   " .. TabName,
            TextColor3 = Theme.SubText,
            TextSize = 13,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left
        }, Sidebar)

        Corner(TabButton, 7)

        local Page = Make("ScrollingFrame", {
            Size = UDim2.new(1, -20, 1, -20),
            Position = UDim2.fromOffset(10, 10),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Blue,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false
        }, Content)

        local PageLayout = Make("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, Page)

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(
                0, 0, 0, PageLayout.AbsoluteContentSize.Y + 15
            )
        end)

        local function SelectTab()
            for _, other in ipairs(Window.Tabs) do
                other.Page.Visible = false
                other.Button.BackgroundTransparency = 1
                other.Button.TextColor3 = Theme.SubText
            end

            Page.Visible = true
            TabButton.BackgroundTransparency = 0
            TabButton.BackgroundColor3 = Theme.Element
            TabButton.TextColor3 = Theme.Blue
            Window.CurrentTab = Tab
        end

        TabButton.MouseButton1Click:Connect(SelectTab)

        Tab.Button = TabButton
        Tab.Page = Page
        table.insert(Window.Tabs, Tab)

        if #Window.Tabs == 1 then
            SelectTab()
        end

        --==================================================
        -- SECTION
        --==================================================

        function Tab:NewSection(SectionName)

            local Section = {}

            local Frame = Make("Frame", {
                Name = SectionName,
                Size = UDim2.new(1, 0, 0, 45),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Panel,
                BorderSizePixel = 0
            }, Page)

            Corner(Frame, 9)

            Make("UIStroke", {
                Color = Theme.Stroke,
                Thickness = 1
            }, Frame)

            Make("TextLabel", {
                Size = UDim2.new(1, -20, 0, 35),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Text = SectionName,
                TextColor3 = Theme.Blue,
                TextSize = 14,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Frame)

            local Holder = Make("Frame", {
                Name = "Elements",
                Position = UDim2.fromOffset(10, 38),
                Size = UDim2.new(1, -20, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1
            }, Frame)

            local Layout = Make("UIListLayout", {
                Padding = UDim.new(0, 7),
                SortOrder = Enum.SortOrder.LayoutOrder
            }, Holder)

            Make("UIPadding", {
                PaddingBottom = UDim.new(0, 10)
            }, Holder)

            Section.Holder = Holder

            -- BUTTON
            function Section:NewButton(Name, Description, Callback)
                local Button = Make("TextButton", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Element,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold
                }, Holder)

                Corner(Button, 7)

                Button.MouseButton1Click:Connect(function()
                    if Callback then
                        task.spawn(Callback)
                    end
                end)

                return Button
            end

            -- TOGGLE
            function Section:NewToggle(Name, Description, Callback)
                local Enabled = false

                local Button = Make("TextButton", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Element,
                    Text = "",
                }, Holder)

                Corner(Button, 7)

                Make("TextLabel", {
                    Size = UDim2.new(1, -60, 1, 0),
                    Position = UDim2.fromOffset(12, 0),
                    BackgroundTransparency = 1,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, Button)

                local Switch = Make("TextLabel", {
                    Size = UDim2.fromOffset(38, 22),
                    Position = UDim2.new(1, -48, 0.5, -11),
                    BackgroundColor3 = Theme.Stroke,
                    Text = "OFF",
                    TextColor3 = Theme.Text,
                    TextSize = 9,
                    Font = Enum.Font.GothamBold
                }, Button)

                Corner(Switch, 10)

                local function SetValue(value)
                    Enabled = value == true
                    Switch.Text = Enabled and "ON" or "OFF"
                    Switch.BackgroundColor3 = Enabled and Theme.Blue or Theme.Stroke

                    if Callback then
                        task.spawn(Callback, Enabled)
                    end
                end

                Button.MouseButton1Click:Connect(function()
                    SetValue(not Enabled)
                end)

                Button.SetValue = SetValue
                Button.GetValue = function()
                    return Enabled
                end

                return Button
            end

            -- LABEL
            function Section:NewLabel(Text)
                local Label = Make("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundTransparency = 1,
                    Text = "  " .. tostring(Text),
                    TextColor3 = Theme.SubText,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, Holder)

                Label.SetText = function(value)
                    Label.Text = "  " .. tostring(value)
                end

                return Label
            end

            -- SLIDER
            function Section:NewSlider(Name, Description, Max, Min, Callback)
                Min = Min or 0
                Max = Max or 100
                local Value = Min

                local Box = Make("Frame", {
                    Size = UDim2.new(1, 0, 0, 65),
                    BackgroundColor3 = Theme.Element
                }, Holder)

                Corner(Box, 7)

                Make("TextLabel", {
                    Size = UDim2.new(0.7, 0, 0, 25),
                    Position = UDim2.fromOffset(12, 5),
                    BackgroundTransparency = 1,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, Box)

                local ValueText = Make("TextLabel", {
                    Size = UDim2.fromOffset(55, 25),
                    Position = UDim2.new(1, -65, 0, 5),
                    BackgroundTransparency = 1,
                    Text = tostring(Value),
                    TextColor3 = Theme.Blue,
                    TextSize = 13,
                    Font = Enum.Font.GothamBold
                }, Box)

                local Bar = Make("TextButton", {
                    Size = UDim2.new(1, -24, 0, 7),
                    Position = UDim2.fromOffset(12, 43),
                    BackgroundColor3 = Theme.Stroke,
                    Text = ""
                }, Box)

                Corner(Bar, 5)

                local Fill = Make("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Theme.Blue
                }, Bar)

                Corner(Fill, 5)

                local function SetValue(value)
                    Value = math.clamp(math.floor(value), Min, Max)
                    local percent = Max == Min and 0 or (Value - Min) / (Max - Min)

                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    ValueText.Text = tostring(Value)

                    if Callback then
                        task.spawn(Callback, Value)
                    end
                end

                local Sliding = false

                local function Update(input)
                    local percent = math.clamp(
                        (input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
                        0, 1
                    )
                    SetValue(Min + (Max - Min) * percent)
                end

                Bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        Sliding = true
                        Update(input)
                    end
                end)

                UIS.InputChanged:Connect(function(input)
                    if Sliding and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        Update(input)
                    end
                end)

                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        Sliding = false
                    end
                end)

                SetValue(Min)
                Box.SetValue = SetValue
                Box.GetValue = function() return Value end
                return Box
            end

            -- DROPDOWN
            function Section:NewDropdown(Name, Description, Options, Callback)
                Options = Options or {}
                local Selected

                local Box = Make("Frame", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Element,
                    ClipsDescendants = true
                }, Holder)

                Corner(Box, 7)

                local Header = Make("TextButton", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundTransparency = 1,
                    Text = Name .. "  ▼",
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold
                }, Box)

                local OptionsHolder = Make("Frame", {
                    Position = UDim2.fromOffset(8, 45),
                    Size = UDim2.new(1, -16, 0, 0),
                    BackgroundTransparency = 1
                }, Box)

                local OptionLayout = Make("UIListLayout", {
                    Padding = UDim.new(0, 5)
                }, OptionsHolder)

                local Open = false

                local function Refresh()
                    for _, child in ipairs(OptionsHolder:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end

                    for _, option in ipairs(Options) do
                        local item = Make("TextButton", {
                            Size = UDim2.new(1, 0, 0, 30),
                            BackgroundColor3 = Theme.Panel,
                            Text = tostring(option),
                            TextColor3 = Theme.Text,
                            TextSize = 12,
                            Font = Enum.Font.Gotham
                        }, OptionsHolder)

                        Corner(item, 5)

                        item.MouseButton1Click:Connect(function()
                            Selected = option
                            Header.Text = Name .. "  " .. tostring(option)
                            Open = false
                            Box.Size = UDim2.new(1, 0, 0, 42)

                            if Callback then
                                task.spawn(Callback, option)
                            end
                        end)
                    end

                    OptionsHolder.Size = UDim2.new(
                        1, -16, 0, OptionLayout.AbsoluteContentSize.Y
                    )
                end

                Header.MouseButton1Click:Connect(function()
                    Open = not Open
                    Box.Size = UDim2.new(
                        1, 0, 0,
                        Open and (50 + OptionLayout.AbsoluteContentSize.Y) or 42
                    )
                end)

                Refresh()

                Box.Refresh = function(newOptions)
                    Options = newOptions or {}
                    Refresh()
                end

                Box.GetValue = function()
                    return Selected
                end

                return Box
            end

            -- TEXTBOX
            function Section:NewTextBox(Name, Description, Callback)
                local Box = Make("Frame", {
                    Size = UDim2.new(1, 0, 0, 65),
                    BackgroundColor3 = Theme.Element
                }, Holder)

                Corner(Box, 7)

                Make("TextLabel", {
                    Size = UDim2.new(0.4, 0, 0, 25),
                    Position = UDim2.fromOffset(12, 5),
                    BackgroundTransparency = 1,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, Box)

                local Input = Make("TextBox", {
                    Size = UDim2.new(0.5, 0, 0, 32),
                    Position = UDim2.new(0.48, 0, 0, 16),
                    BackgroundColor3 = Theme.Panel,
                    Text = "",
                    PlaceholderText = "Enter text...",
                    TextColor3 = Theme.Text,
                    PlaceholderColor3 = Theme.SubText,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false
                }, Box)

                Corner(Input, 5)

                Input.FocusLost:Connect(function(enter)
                    if enter and Callback then
                        task.spawn(Callback, Input.Text)
                    end
                end)

                Box.GetValue = function()
                    return Input.Text
                end

                return Box
            end

            -- KEYBIND
            function Section:NewKeybind(Name, Description, DefaultKey, Callback)
                local CurrentKey = DefaultKey or Enum.KeyCode.RightShift
                local Listening = false

                local Button = Make("TextButton", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Element,
                    Text = Name .. "     [" .. CurrentKey.Name .. "]",
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold
                }, Holder)

                Corner(Button, 7)

                Button.MouseButton1Click:Connect(function()
                    Listening = true
                    Button.Text = Name .. "     [Press key]"
                end)

                local Connection = UIS.InputBegan:Connect(function(input, processed)
                    if Listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        CurrentKey = input.KeyCode
                        Listening = false
                        Button.Text = Name .. "     [" .. CurrentKey.Name .. "]"
                        return
                    end

                    if not processed
                    and input.UserInputType == Enum.UserInputType.Keyboard
                    and input.KeyCode == CurrentKey then
                        if Callback then
                            task.spawn(Callback, CurrentKey)
                        end
                    end
                end)

                Button.Destroying:Connect(function()
                    Connection:Disconnect()
                end)

                Button.GetKey = function()
                    return CurrentKey
                end

                return Button
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        return Tab
    end

    return Window
end

return Library
